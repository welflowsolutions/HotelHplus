# macOS / editor noise
.DS_Store
._*
.idea/
.vscode/
*.swp
*.swo

# Environment and secrets
.env
.env.*
!.env.example

# Dependency directories
vendor/
node_modules/

# Build/cache outputs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# CodeIgniter writable runtime files
writable/cache/*
writable/debugbar/*
writable/logs/*
writable/session/*
writable/uploads/*
!writable/.htaccess
!writable/index.html
!writable/cache/.gitkeep
!writable/debugbar/.gitkeep
!writable/logs/.gitkeep
!writable/session/.gitkeep
!writable/uploads/.gitkeep

# Backups and archives
*.zip
*.tar
*.tar.gz
*.sql
*.sqlite
*.bak
backup*/
backup *

# Test and coverage artifacts
coverage/
.phpunit.cache/
phpunit.result.cache
build/.phpunit.cache/
build/logs/

# Local generated files
public/hot/
